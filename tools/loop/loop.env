# Réglages de la boucle, lus par tous les scripts de tools/loop (via lib.sh).
# Surcharges locales non versionnées : tools/loop/loop.local.env (même syntaxe).

# Session
LOOP_TMUX_SESSION=genesis-loop
LOOP_MODEL=claude-sonnet-5-5
LOOP_EFFORT=high
LOOP_BRANCH=loop                      # branche du worktree de la boucle ; publiée sur origin/main
LOOP_WORKTREE_NAME=ai_voice_ui-loop   # worktree créé à côté du dépôt du porteur

# Quota Claude (pourcentages)
LOOP_MAX_5H=90          # pause au-delà, jusqu'à la remise à zéro de la fenêtre 5 h
LOOP_WEEK_SHARE=90      # part de la semaine que la boucle peut consommer, lissée sur la semaine
LOOP_WEEK_MARGIN=10     # avance tolérée sur le lissage, en points
LOOP_MAX_7D=95          # plafond hebdomadaire absolu de la boucle (le reste est pour le porteur)
LOOP_QUOTA_STALE_S=3600 # données de quota plus vieilles : UNKNOWN

# Budget OpenAI (euros) : 20 € au total pour le porteur, dont ce plafond pour la boucle
LOOP_OPENAI_CAP_EUR=12

# Superviseur
LOOP_SUPERVISE_S=300    # période de contrôle
LOOP_STALE_S=5400       # sans activité (outil) depuis ce délai et session inactive : relance
LOOP_MAX_WAKEUP_S=3600  # au-delà, la boucle s'arrête et le superviseur la relance à l'heure
