{
  "color": {
    "background": {
      "$type": "color",
      "$value": "{color.void}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.surface100}"
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.inkMuted}"
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.signal}"
    },
    "outline": {
      "highlight": {
        "$type": "color",
        "$value": "{color.signal}"
      }
    },
    "status": {
      "ok": {
        "background": {
          "$type": "color",
          "$value": "{color.goGhost}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.go}"
        }
      },
      "risk": {
        "background": {
          "$type": "color",
          "$value": "{color.warnGhost}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.warn}"
        }
      },
      "blocking": {
        "background": {
          "$type": "color",
          "$value": "{color.nogoGhost}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.nogo}"
        }
      },
      "neutral": {
        "background": {
          "$type": "color",
          "$value": "{color.surface300}"
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.inkMuted}"
        }
      }
    },
    "action": {
      "neutralBorder": {
        "$type": "color",
        "$value": "{color.inkMuted}"
      },
      "dangerBorder": {
        "$type": "color",
        "$value": "{color.nogo}"
      }
    },
    "agent": {
      "working": {
        "$type": "color",
        "$value": "{color.signal}"
      },
      "idle": {
        "$type": "color",
        "$value": "{color.inkFaint}"
      },
      "rejected": {
        "$type": "color",
        "$value": "{color.warn}"
      },
      "interrupted": {
        "$type": "color",
        "$value": "{color.baseline}"
      }
    },
    "chart": {
      "ios": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "android": {
        "$type": "color",
        "$value": "{color.signal}"
      },
      "other": {
        "$type": "color",
        "$value": "{color.baseline}"
      }
    }
  }
}
